{
  "name": "@clawnify/open-fieldservice",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/setup-db.mjs && concurrently -n ui,api -c cyan,green \"vite\" \"wrangler dev --port 8787\"",
    "build": "vite build",
    "db:setup": "node scripts/setup-db.mjs",
    "test": "node --test tests/*.test.mjs",
    "db:migrate-uuids": "node scripts/setup-db.mjs --migrate-uuids",
    "previews:build": "node scripts/build-previews.mjs build",
    "previews:check": "node scripts/build-previews.mjs check",
    "previews:export": "node scripts/build-previews.mjs export"
  },
  "dependencies": {
    "@clawnify/app": "^0.1.0",
    "@clawnify/db": "^0.4.1",
    "@hono/zod-openapi": "^0.18.0",
    "hono": "^4.6.0",
    "lucide-preact": "^0.575.0",
    "preact": "^10.25.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.9.0",
    "concurrently": "^9.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "wrangler": "^4.0.0"
  }
}
