    "next": "^16.0.0",
    "next-auth": "5.0.0-beta.30",
    "next-themes": "^0.4.0",
    "postgres": "^3.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "sharp": "^0.34.0",
